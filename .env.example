# LLM / OpenAI-compatible endpoint
BASE_URL=
FEEDBACK_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# FFmpeg (optional absolute path; leave empty to use PATH)
FFMPEG_PATH=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
RUNTIME_DIR=runtime
MAX_UPLOAD_MB=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VAGENT_ENV=development

# PostgreSQL (required in production; optional in development)
# Example local docker-compose.dev.yml (host port 5433 avoids clashing with local Postgres):
# DATABASE_URL=postgresql+psycopg://vagent:vagent@127.0.0.1:5433/vagent
DATABASE_URL=

# Do not set this to VERIFIED_TOSS_SUBJECT to treat client headers as auth.
# Verified identity requires server-side Toss login (authorization code exchange).
TOSS_IDENTITY_TRUST_MODE=UNVERIFIED_CLIENT_SUBJECT

# Payments (off by default). Production requires mTLS + real SKUs + Toss login.
PAYMENTS_ENABLED=false
TOSS_LOGIN_ENABLED=false
VAGENT_SESSION_SECRET=
IAP_SONG_DETAIL_SKU=
IAP_DIAGNOSTIC_FULL_SKU=
IAP_DIAGNOSTIC_UPGRADE_SKU=
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
BACKEND_REPLICAS=1

# Artifact storage: LOCAL_PERSISTENT under RUNTIME_DIR (single-backend launch)
# MULTI_INSTANCE UNSAFE until object storage is wired
ARTIFACT_STORAGE_MODE=LOCAL_PERSISTENT

# Public backend HTTPS origin (set after cloud deploy). Used to compose:
#   {PUBLIC_BACKEND_BASE_URL}/legal/terms
#   {PUBLIC_BACKEND_BASE_URL}/legal/privacy
#   {PUBLIC_BACKEND_BASE_URL}/legal/privacy-consent
#   {PUBLIC_BACKEND_BASE_URL}/v1/auth/toss/disconnect
PUBLIC_BACKEND_BASE_URL=

# Toss login disconnect callback (Apps in Toss console Basic Auth). Do not commit secrets.
# Register POST {PUBLIC_BACKEND_BASE_URL}/v1/auth/toss/disconnect
TOSS_DISCONNECT_BASIC_USER=
TOSS_DISCONNECT_BASIC_PASSWORD=

# Singer Identity product integration (all OFF by default — fail-open optional side signal)
SINGER_IDENTITY_ENABLED=false
SINGER_IDENTITY_ENROLLMENT_ENABLED=false
PERSONAL_VOCAL_BASELINE_ENABLED=false
SINGER_IDENTITY_SHADOW_K2_ENABLED=false
SINGER_IDENTITY_SERVICE_URL=http://127.0.0.1:8100
SINGER_IDENTITY_TIMEOUT_SECONDS=2.5
