# LLM / OpenAI-compatible endpoint
BASE_URL=
FEEDBACK_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# FFmpeg (optional absolute path; leave empty to use PATH)
FFMPEG_PATH=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
RUNTIME_DIR=runtime
MAX_UPLOAD_MB=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VAGENT_ENV=development

# PostgreSQL (required in production; optional in development)
# Example local docker-compose.dev.yml (host port 5433 avoids clashing with local Postgres):
# DATABASE_URL=postgresql+psycopg://vagent:vagent@127.0.0.1:5433/vagent
DATABASE_URL=

# Identity trust boundary (default: client-asserted identifier, NOT verified auth)
# UNVERIFIED_CLIENT_SUBJECT | VERIFIED_TOSS_SUBJECT
TOSS_IDENTITY_TRUST_MODE=UNVERIFIED_CLIENT_SUBJECT

# Artifact storage: LOCAL_PERSISTENT under RUNTIME_DIR (single-backend launch)
# MULTI_INSTANCE UNSAFE until object storage is wired
ARTIFACT_STORAGE_MODE=LOCAL_PERSISTENT

# Singer Identity product integration (all OFF by default — fail-open optional side signal)
SINGER_IDENTITY_ENABLED=false
SINGER_IDENTITY_ENROLLMENT_ENABLED=false
PERSONAL_VOCAL_BASELINE_ENABLED=false
SINGER_IDENTITY_SHADOW_K2_ENABLED=false
SINGER_IDENTITY_SERVICE_URL=http://127.0.0.1:8100
SINGER_IDENTITY_TIMEOUT_SECONDS=2.5
