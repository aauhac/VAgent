# Production environment (names only)

Copy to the secret store / platform env. Do not put secret VALUES in git.

VAGENT_ENV=production

# Public HTTPS origin of this backend after cloud deploy (no trailing slash).
# Cloud platform hostname is allowed. Do not use localhost or a placeholder domain.
PUBLIC_BACKEND_BASE_URL=

# Production CORS. If unset, defaults to the verified vocalfb Toss origins:
#   https://vocalfb.apps.tossmini.com
#   https://vocalfb.private-apps.tossmini.com
# Localhost is stripped/rejected. Wildcard * is forbidden.
CORS_ORIGINS=https://vocalfb.apps.tossmini.com,https://vocalfb.private-apps.tossmini.com

# PostgreSQL. On Lightsail compose the hostname is the service name `postgres`.
# Example (values filled only on the server, never in git):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/vocalfb
DATABASE_URL=

# Compose Postgres identity (used by the postgres image; keep in sync with DATABASE_URL).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=vocalfb

# Runtime volume. LOCAL_PERSISTENT + replica 1. Must be absolute in the container.
RUNTIME_DIR=/var/lib/vocalfb/runtime
ARTIFACT_STORAGE_MODE=LOCAL_PERSISTENT
BACKEND_REPLICAS=1

# Future S3 + SQS analysis worker (unused until the analysis path is switched).
# Leave empty on this host until STEP 3. Do not put AWS credentials here.
# Keep local until an SQS worker exists.
VAGENT_ANALYSIS_EXECUTION_MODE=local
# VAGENT_S3_BUCKET=
# AWS_REGION=
# VAGENT_ANALYSIS_QUEUE_URL=
# VAGENT_ANALYSIS_DLQ_URL=
# VAGENT_SQS_VISIBILITY_TIMEOUT=600
# VAGENT_SQS_WAIT_TIME_SECONDS=20
# VAGENT_SQS_HEARTBEAT_SECONDS=120
# VAGENT_SQS_RETRY_VISIBILITY_SECONDS=60
# WORKER_RUNTIME_DIR=/var/lib/vocalfb/worker

# Process
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=30
PHYSIOLOGY_DEBUG=false
ALLOW_MOCK_PREMIUM=false
SINGER_IDENTITY_ENABLED=false

# Payments / login
PAYMENTS_ENABLED=false
TOSS_LOGIN_ENABLED=false
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_IDENTITY_TRUST_MODE=UNVERIFIED_CLIENT_SUBJECT
VAGENT_SESSION_SECRET=
TOSS_MTLS_CERT_PATH=/etc/vocalfb/secrets/toss-client.crt
TOSS_MTLS_KEY_PATH=/etc/vocalfb/secrets/toss-client.key
IAP_SONG_DETAIL_SKU=
IAP_DIAGNOSTIC_FULL_SKU=
IAP_DIAGNOSTIC_UPGRADE_SKU=
TOSS_DISCONNECT_BASIC_USER=
TOSS_DISCONNECT_BASIC_PASSWORD=

# Analysis-complete smart message. Leave empty until Console template exists.
# TOSS_ANALYSIS_COMPLETE_TEMPLATE_SET_CODE=

# Miniapp production build (set when the backend HTTPS hostname exists, then rebuild):
# VITE_API_BASE=<same value as PUBLIC_BACKEND_BASE_URL>
# VITE_TOSS_ANALYSIS_COMPLETE_TEMPLATE_CODE=
# VITE_TOSS_REWARDED_DETAIL_AD_GROUP_ID=  # empty until Apps in Toss console issues ID
