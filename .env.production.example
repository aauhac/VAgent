# Production environment (names only)

Copy to the secret store / platform env. Do not put secret VALUES in git.

VAGENT_ENV=production

# Public HTTPS origin of this backend after cloud deploy (no trailing slash).
# Cloud platform hostname is allowed. Do not use localhost or a placeholder domain.
PUBLIC_BACKEND_BASE_URL=

# Production CORS. If unset, defaults to the verified vocalfb Toss origins:
#   https://vocalfb.apps.tossmini.com
#   https://vocalfb.private-apps.tossmini.com
# Localhost is stripped/rejected. Wildcard * is forbidden.
CORS_ORIGINS=https://vocalfb.apps.tossmini.com,https://vocalfb.private-apps.tossmini.com

# PostgreSQL. Provider SSL belongs in this URL (for example sslmode=require) if the vendor requires it.
DATABASE_URL=

# Runtime volume mount. LOCAL_PERSISTENT + replica 1.
RUNTIME_DIR=
ARTIFACT_STORAGE_MODE=LOCAL_PERSISTENT
BACKEND_REPLICAS=1

# Process
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=30
PHYSIOLOGY_DEBUG=false
ALLOW_MOCK_PREMIUM=false
SINGER_IDENTITY_ENABLED=false

# Payments / login
PAYMENTS_ENABLED=false
TOSS_LOGIN_ENABLED=false
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_IDENTITY_TRUST_MODE=UNVERIFIED_CLIENT_SUBJECT
VAGENT_SESSION_SECRET=
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=
IAP_SONG_DETAIL_SKU=
IAP_DIAGNOSTIC_FULL_SKU=
IAP_DIAGNOSTIC_UPGRADE_SKU=
TOSS_DISCONNECT_BASIC_USER=
TOSS_DISCONNECT_BASIC_PASSWORD=

# Miniapp production build (set when the backend HTTPS hostname exists, then rebuild):
# VITE_API_BASE=<same value as PUBLIC_BACKEND_BASE_URL>
