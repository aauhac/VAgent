# VocalFB production backend — FastAPI + in-process job runner.
# Context: repository root. Do not copy secrets.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/vocalfb/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin vocalfb

WORKDIR /opt/vocalfb/app

COPY --chown=vocalfb:vocalfb requirements.txt /opt/vocalfb/app/requirements.txt
ARG INSTALL_SEPARATION=0
COPY --chown=vocalfb:vocalfb requirements-separation.txt /opt/vocalfb/app/requirements-separation.txt
RUN pip install --upgrade pip \
    && pip install --prefer-binary -r /opt/vocalfb/app/requirements.txt

# CPU-only separation support (torch/demucs).
# Do NOT install CUDA wheels: use PyTorch CPU index explicitly.
RUN if [ "$INSTALL_SEPARATION" = "1" ]; then \
      pip install --upgrade pip && \
      pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.11.0 torchaudio==2.11.0 && \
      pip install -r /opt/vocalfb/app/requirements-separation.txt ; \
    else \
      echo "Skipping separation deps (INSTALL_SEPARATION=0)" ; \
    fi

COPY --chown=vocalfb:vocalfb alembic.ini /opt/vocalfb/app/alembic.ini
COPY --chown=vocalfb:vocalfb backend /opt/vocalfb/app/backend
COPY --chown=vocalfb:vocalfb audio_analyzer /opt/vocalfb/app/audio_analyzer
COPY --chown=vocalfb:vocalfb docs/legal /opt/vocalfb/app/docs/legal

USER vocalfb

EXPOSE 8000

# Single worker: JobRunner and LOCAL_PERSISTENT artifacts are process-local.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
